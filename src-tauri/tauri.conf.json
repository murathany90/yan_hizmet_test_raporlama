{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TEİAŞ-YHDA",
  "version": "0.6.0",
  "identifier": "tr.gov.teias.yhda",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TEİAŞ Yan Hizmetler Doğrulama Aracı",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "TEİAŞ yan hizmet test doğrulama ve raporlama aracı",
    "longDescription": "PFK, RGDH, HFK, SFHM ve SFK test CSV dosyalarını doğrulayan, grafikleyen ve raporlayan masaüstü uygulaması.",
    "windows": {
      "wix": {
        "language": "tr-TR"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Turkish"]
      }
    }
  }
}
